# Any OpenAI-compatible provider — change these three values only.

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Examples:
# DeepSeek:  LLM_BASE_URL=https://api.deepseek.com   LLM_MODEL=deepseek-chat
# OpenAI:    LLM_BASE_URL=                           LLM_MODEL=gpt-4o-mini
#            (leave LLM_BASE_URL empty for official OpenAI)
